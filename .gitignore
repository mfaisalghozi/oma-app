*.test

# Flutter flavor config (copy config/dev.example.json to config/dev.json)
apps/mobile/config/*.json
!apps/mobile/config/*.example.json

# Golden test failure artifacts
apps/mobile/test/**/failures/

# Local implementation notes
/docs/
