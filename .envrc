# Scope GitHub CLI + git auth to the PERSONAL account for this repo only.
#
# gh has no per-repo account setting, so we export GH_TOKEN, which takes
# precedence over the active account in ~/.config/gh/hosts.yml for every gh
# command and for git pushes through the gh credential helper.
#
# Values are read from the keyring at load time -- no secret is stored here.
export GH_TOKEN="$(gh auth token --user mfaisalghozi 2>/dev/null)"

if [ -z "${GH_TOKEN}" ]; then
  echo "oma-app: could not read the mfaisalghozi token; run 'gh auth login -h github.com -u mfaisalghozi'" >&2
fi
