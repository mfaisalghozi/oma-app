# Supabase runtime configuration; keep real values in your shell or an ignored .env file.
# Go does not automatically load .env files.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_KEY
API_ADDR=:8080

# Disposable integration database only; never use staging/production here.
TEST_DATABASE_URL=postgresql://postgres:oma_test@127.0.0.1:55432/oma_test?sslmode=disable
