# Supabase runtime configuration; keep real values in your shell or an ignored .env file.
# Go does not automatically load .env files.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_KEY
API_ADDR=:8080

# Disposable integration database only; never use staging/production here.
TEST_DATABASE_URL=postgresql://postgres:oma_test@127.0.0.1:55432/oma_test?sslmode=disable

# Optional explicit Discovery ranking/deck policy; unset keeps Discovery routes at503.
# Example tuning values are not product-approved production defaults.
DISCOVERY_POLICY_FILE=config/discovery.example.json
# Trusted development-only PRO allowlist. Nonempty IDs are rejected outside local/development/test.
# APP_ENV=development
# DEVELOPMENT_PRO_USER_IDS=11111111-1111-4111-8111-111111111111
# The score worker requires a validated DISCOVERY_POLICY_FILE and fixed 30-day like half-life.
# Apply River-owned migrations explicitly with: go run ./cmd/worker -migrate
